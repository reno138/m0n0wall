#
# M0N0WALL_GENERIC -- amd64
#
# Derived from m0n0wall's FreeBSD 8.4 config and brought forward to FreeBSD
# 15.1. The original is kept beside this file as M0N0WALL_GENERIC.amd64.freebsd8.
#
# A NOTE FOR ANYONE TRIMMING THIS FILE.
#
# Three entries here are declared by NO driver line and look unused. They are
# not. FreeBSD has progressively split shared infrastructure out of the drivers
# that use it, and the dependency is invisible at the point of use:
#
#   device iflib   -- em(4) and friends moved to the iflib framework, which
#                     generates ifdi_if.h at build time. Without it the build
#                     dies with "'ifdi_if.h' file not found" from inside
#                     dev/e1000, naming nothing useful.
#   device hid     -- uhid(4) and ukbd(4) link against the HID subsystem. Without
#   device hidbus     hid/hidbus/usbhid the kernel COMPILES and then fails to
#   device usbhid     LINK with undefined hid_locate, hid_is_keyboard and so on.
#
# Both were found by compiling, not by reading GENERIC, because GENERIC lists
# them under their own headings far from the drivers that need them. Delete
# them only after a clean build proves they are genuinely unused.
#
# Lines marked "# REMOVED-15.1:" were rejected by config(8) on 15.1 and are
# kept commented for provenance rather than deleted.
#
cpu		HAMMER	
ident		M0N0WALL_GENERIC64

makeoptions	MODULES_OVERRIDE="dummynet glxsb aesni padlock ipfw if_vlan"	# if_tap merged into tuntap (compiled in); runfw removed from the tree

options		HZ=1000

hints		"M0N0WALL_GENERIC.hints"

options 	SCHED_ULE		# ULE scheduler
options 	PREEMPTION		# Enable kernel thread preemption
options 	INET			# InterNETworking
options 	INET6			# IPv6 communications protocols
options 	FFS			# Berkeley Fast Filesystem
options 	SOFTUPDATES		# Enable FFS soft updates support
options 	MD_ROOT			# MD is a potential root device
options 	MSDOSFS			# MSDOS Filesystem
options 	CD9660			# ISO 9660 Filesystem
options 	GEOM_PART_GPT		# GPT partitioning (the new image layout)
options 	GEOM_PART_MBR		# protective MBR / legacy BIOS boot
options 	GEOM_LABEL		# provides /dev/ufs/m0n0wall
# REMOVED (not in FreeBSD 15): options 	COMPAT_43TTY		# BSD 4.3 TTY compat (sgtty)
options 	SCSI_DELAY=5000		# Delay (in ms) before probing SCSI
options 	SYSVSHM			# SYSV-style shared memory
options 	SYSVMSG			# SYSV-style message queues
options 	SYSVSEM			# SYSV-style semaphores
options 	_KPOSIX_PRIORITY_SCHEDULING # POSIX P1003_1B real-time extensions
# REMOVED (not in FreeBSD 15): options 	KBD_INSTALL_CDEV	# install a CDEV entry in /dev
# REMOVED (not in FreeBSD 15): options 	FLOWTABLE		# per-cpu routing cache

# To make an SMP kernel, the next line is needed
options 	SMP			# Symmetric MultiProcessor Kernel

# CPU frequency control
device		cpufreq

# REMOVED-15.1: options		NO_SWAPPING
options         DEVICE_POLLING

options		IPSEC

# --- packet filter -------------------------------------------------------
# pf replaces ipfilter, which upstream abandoned in 2014 and which nothing
# new is built on. ALTQ is not used: shaping stays on ipfw + dummynet.
device		pf
device		pflog
device		pfsync

# wg(4), the WireGuard driver. wireguard-tools was in the image from the start
# but this was not, so wireguard.inc's first step -- "ifconfig wg0 create" --
# failed with "SIOCIFCREATE2 (wg0): Invalid argument" and the entire mesh VPN
# feature could not work. Nothing is shipped as a loadable module (kldstat
# shows only the kernel), so it has to be compiled in.
device		wg

# ipfw stays for the traffic shaper and the captive portal. Both filters
# register on the same pfil hooks -- see the ordering note in filter_pf.inc.
options		IPFIREWALL
options		IPFIREWALL_DEFAULT_TO_ACCEPT
options		DUMMYNET
# REMOVED (not in FreeBSD 15): options		IPSEC_NAT_T
device		enc

# REMOVED (not in FreeBSD 15): options		IPFILTER
# REMOVED (not in FreeBSD 15): options		IPFILTER_LOG
# REMOVED (not in FreeBSD 15): options		IPFILTER_DEFAULT_BLOCK
# REMOVED (not in FreeBSD 15): options		IPSTATE_SIZE=42859
# REMOVED (not in FreeBSD 15): options		IPSTATE_MAX=30000
# REMOVED (not in FreeBSD 15): options		IPFIREWALL_FORWARD
options		IPSTEALTH

# Bus support.
device		pci
device		acpi

# Floppy drives
device		fdc

# ATA and ATAPI devices
device		ata
# REMOVED (not in FreeBSD 15): device		atadisk		# ATA disk drives
# REMOVED (not in FreeBSD 15): device		ataraid		# ATA RAID drives
# REMOVED (not in FreeBSD 15): device		atapicd		# ATAPI CDROM drives
# REMOVED (not in FreeBSD 15): device		atapifd		# ATAPI floppy drives
options 	ATA_STATIC_ID	# Static device numbering

# SCSI Controllers
device		ahc		# AHA2940 and onboard AIC7xxx devices
options 	AHC_REG_PRETTY_PRINT	# Print register bitfields in debug
					# output.  Adds ~128k to driver.
device		ahd		# AHA39320/29320 and onboard AIC79xx devices
options 	AHD_REG_PRETTY_PRINT	# Print register bitfields in debug
					# output.  Adds ~215k to driver.
# REMOVED-15.1: device		amd		# AMD 53C974 (Tekram DC-390(T))
device		hptiop		# Highpoint RocketRaid 3xxx series
device		isp		# Qlogic family
#device		ispfw		# Firmware for QLogic HBAs- normally a module
device		mpt		# LSI-Logic MPT-Fusion
device		mps		# LSI-Logic MPT-Fusion 2
#device		ncr		# NCR/Symbios Logic
device		sym		# NCR/Symbios Logic (newer chipsets + those of `ncr')
# REMOVED (not in FreeBSD 15): device		trm		# Tekram DC395U/UW/F DC315U adapters

# REMOVED (not in FreeBSD 15): device		adv		# Advansys SCSI adapters
# REMOVED (not in FreeBSD 15): device		adw		# Advansys wide SCSI adapters
# REMOVED (not in FreeBSD 15): device		aic		# Adaptec 15[012]x SCSI adapters, AIC-6[23]60.
# REMOVED (not in FreeBSD 15): device		bt		# Buslogic/Mylex MultiMaster SCSI adapters
device		isci		# Intel C600 SAS controller

# REMOVED-15.1: device		ncv		# NCR 53C500
# REMOVED-15.1: device		nsp		# Workbit Ninja SCSI-3
# REMOVED-15.1: device		stg		# TMC 18C30/18C50

# SCSI peripherals
# --- modern storage ------------------------------------------------------
# None of this existed in m0n0wall's 8.4 config, which is why a build from it
# cannot see a disk on anything made in the last decade.
device		ahci		# AHCI SATA -- every modern SATA controller
device		nvme		# NVMe controller
device		nvd		# NVMe namespaces as disks (nvd0, nvd1, ...)

# --- virtio --------------------------------------------------------------
# Required to run as a VM guest at all (Proxmox, bhyve, KVM, QEMU). The first
# test target for this build is a Proxmox VM, so this is not optional.
device		virtio
device		virtio_pci
device		vtnet		# VirtIO network
device		virtio_blk	# VirtIO block (vtbd0)
device		virtio_scsi
device		virtio_balloon

device		scbus		# SCSI bus (required for ATA/SCSI)
device		ch		# SCSI media changers
device		da		# Direct Access (disks)
device		sa		# Sequential Access (tape etc)
device		cd		# CD
device		pass		# Passthrough device (direct SCSI access)
device		ses		# SCSI Environmental Services (and SAF-TE)

# RAID controllers interfaced to the SCSI subsystem
# REMOVED-15.1: device		amr		# AMI MegaRAID
device		arcmsr		# Areca SATA II RAID
device		ciss		# Compaq Smart RAID 5*
# REMOVED-15.1: device		dpt		# DPT Smartcache III, IV - See NOTES for options
device		hptmv		# Highpoint RocketRAID 182x
device		hptrr		# Highpoint RocketRAID 17xx, 22xx, 23xx, 25xx
# REMOVED-15.1: device		iir		# Intel Integrated RAID
device		ips		# IBM (Adaptec) ServeRAID
# REMOVED-15.1: device		mly		# Mylex AcceleRAID/eXtremeRAID
# REMOVED-15.1: device		twa		# 3ware 9000 series PATA/SATA RAID

# RAID controllers
device		aac		# Adaptec FSA RAID
device		aacp		# SCSI passthrough for aac (requires CAM)
device		ida		# Compaq Smart RAID
device		mfi		# LSI MegaRAID SAS
device		mlx		# Mylex DAC960 family
# REMOVED-15.1: device		twe		# 3ware ATA RAID
device		tws		# LSI 3ware 9750 SATA+SAS 6Gb/s RAID controller

# atkbdc0 controls both the keyboard and the PS/2 mouse
device		atkbdc		# AT keyboard controller
device		atkbd		# AT keyboard

device		kbdmux		# keyboard multiplexer

device		vga		# VGA video card driver

# syscons is the default console driver, resembling an SCO console
device		sc

# PCCARD (PCMCIA) support
# PCMCIA and cardbus bridge support
device		cbb		# cardbus (yenta) bridge
# REMOVED-15.1: device		pccard		# PC Card (16-bit) bus
device		cardbus		# CardBus (32-bit) bus

# Serial (COM) ports
device		uart		# Generic UART driver

# PCI Ethernet NICs.
# REMOVED-15.1: device		de		# DEC/Intel DC21x4x (``Tulip'')
# PCI/PCIe Ethernet NICs that use the iflib infrastructure.
# em(4) moved to iflib, which generates ifdi_if.h -- without this the build
# fails with 'ifdi_if.h file not found'.
device		iflib

device		em		# Intel PRO/1000 Gigabit Ethernet Family
# REMOVED-15.1: device		igb		# Intel PRO/1000 PCIE Server Gigabit Family
# REMOVED-15.1: device		ixgb		# Intel PRO/10GbE Ethernet Card
device		le		# AMD Am7900 LANCE and Am79C9xx PCnet
device		ti		# Alteon Networks Tigon I/II gigabit Ethernet
# REMOVED-15.1: device		txp		# 3Com 3cR990 (``Typhoon'')
# REMOVED-15.1: device		vx		# 3Com 3c590, 3c595 (``Vortex'')

# PCI Ethernet NICs that use the common MII bus controller code.
# NOTE: Be sure to keep the 'device miibus' line in order to use these NICs!
device		miibus		# MII bus support
device		ae		# Attansic/Atheros L2 FastEthernet
device		age		# Attansic/Atheros L1 Gigabit Ethernet
device		alc		# Atheros AR8131/AR8132 Ethernet
device		ale		# Atheros AR8121/AR8113/AR8114 Ethernet
device		bce		# Broadcom BCM5706/BCM5708 Gigabit Ethernet
device		bfe		# Broadcom BCM440x 10/100 Ethernet
device		bge		# Broadcom BCM570xx Gigabit Ethernet
device		dc		# DEC/Intel 21143 and various workalikes
device		et		# Agere ET1310 10/100/Gigabit Ethernet
device		fxp		# Intel EtherExpress PRO/100B (82557, 82558)
device		jme		# JMicron JMC250 Gigabit/JMC260 Fast Ethernet
device		lge		# Level 1 LXT1001 gigabit Ethernet
device		msk		# Marvell/SysKonnect Yukon II Gigabit Ethernet
device		nfe		# nVidia nForce MCP on-board Ethernet
device		nge		# NatSemi DP83820 gigabit Ethernet
#device		nve		# nVidia nForce MCP on-board Ethernet Networking
# REMOVED-15.1: device		pcn		# AMD Am79C97x PCI 10/100 (precedence over 'le')
device		re		# RealTek 8139C+/8169/8169S/8110S
device		rl		# RealTek 8129/8139
# REMOVED-15.1: device		sf		# Adaptec AIC-6915 (``Starfire'')
device		sge		# Silicon Integrated Systems SiS190/191
device		sis		# Silicon Integrated Systems SiS 900/SiS 7016
device		sk		# SysKonnect SK-984x & SK-982x gigabit Ethernet
device		ste		# Sundance ST201 (D-Link DFE-550TX)
device		stge		# Sundance/Tamarack TC9021 gigabit Ethernet
# REMOVED-15.1: device		tl		# Texas Instruments ThunderLAN
# REMOVED-15.1: device		tx		# SMC EtherPower II (83c170 ``EPIC'')
device		vge		# VIA VT612x gigabit Ethernet
device		vr		# VIA Rhine, Rhine II
# REMOVED-15.1: device		wb		# Winbond W89C840F
device		xl		# 3Com 3c90x (``Boomerang'', ``Cyclone'')

# ISA Ethernet NICs.  pccard NICs included.
# REMOVED-15.1: device		cs		# Crystal Semiconductor CS89x0 NIC
# 'device ed' requires 'device miibus'
# REMOVED-15.1: device		ed		# NE[12]000, SMC Ultra, 3c503, DS8390 cards
# REMOVED-15.1: device		ex		# Intel EtherExpress Pro/10 and Pro/10+
# REMOVED-15.1: device		ep		# Etherlink III based cards
# REMOVED-15.1: device		fe		# Fujitsu MB8696x based cards
# REMOVED-15.1: device		sn		# SMC's 9000 series of Ethernet chips
# REMOVED-15.1: device		xe		# Xircom pccard Ethernet

# Wireless NIC cards
device		wlan		# 802.11 support
# REMOVED-15.1: options 	IEEE80211_AMPDU_AGE # age frames in AMPDU reorder q's
options 	IEEE80211_SUPPORT_MESH	# enable 802.11s draft support
device          wlan_wep                #802.11 WEP support
device          wlan_ccmp               #802.11 CCMP support
device          wlan_tkip               #802.11 TKIP support
device		wlan_amrr	# AMRR transmit rate control algorithm
device          wlan_xauth              #802.11 external authenticator support
device          wlan_acl				#802.11 MAC-based ACL support
# REMOVED-15.1: device		an		# Aironet 4500/4800 802.11 wireless NICs.
device          ath             # Atheros pci/cardbus NIC's
device          ath_hal         # pci/cardbus chip support
# REMOVED-15.1: options         AH_SUPPORT_AR5416       # enable AR5416 tx/rx descriptors
device          ath_rate_sample # SampleRate tx rate control for ath
device		ral		# Ralink Technology RT2500 wireless NICs.
# REMOVED-15.1: device		wi		# WaveLAN/Intersil/Symbol 802.11 wireless NICs.

# Pseudo devices.
device		loop		# Network loopback
# REMOVED-15.1: device		random		# Entropy device
device		ether		# Ethernet support
device		tuntap		# packet tunnel; FreeBSD 12 merged tun+tap into tuntap
device		pty		# Pseudo-ttys (telnet etc)
device		md		# Memory "disks"
device		gif		# IPv6 and IPv4 tunneling
device		stf		# 6to4 IPv6 over IPv4 encapsulation
device		firmware	# firmware assist module
device		if_bridge	#Bridge interface
device          vlan

# The `bpf' device enables the Berkeley Packet Filter.
# Be aware of the administrative consequences of enabling this!
# Note that 'bpf' is required for DHCP.
device		bpf		# Berkeley packet filter

options 	NETGRAPH		#netgraph(4) system
options 	NETGRAPH_ASYNC
options		NETGRAPH_BPF
options 	NETGRAPH_ETHER
options 	NETGRAPH_IFACE
options 	NETGRAPH_KSOCKET
options 	NETGRAPH_L2TP
options 	NETGRAPH_MPPC_ENCRYPTION
options 	NETGRAPH_PPP
options 	NETGRAPH_PPPOE
options 	NETGRAPH_PPTPGRE
options 	NETGRAPH_SOCKET
options         NETGRAPH_TCPMSS
options 	NETGRAPH_TEE
options 	NETGRAPH_UI
options 	NETGRAPH_VJC
options		NETGRAPH_TTY

device		crypto
device		cryptodev
device		hifn

# USB support
device		uhci		# UHCI PCI->USB interface
device		ohci		# OHCI PCI->USB interface
device		ehci		# EHCI PCI->USB interface (USB 2.0)
# XHCI is not optional on anything built in roughly the last decade. Plenty of
# modern boards expose NO EHCI/UHCI/OHCI controller at all, so without this the
# kernel finds no USB bus whatsoever: no USB keyboard for the console (ukbd), no
# installing from a USB stick (umass), and no 3G/LTE modem for the Modem WAN
# type (u3g). It went unnoticed because a QEMU guest is given a UHCI/EHCI
# controller, so USB works in a VM and dies on real hardware.
device		xhci		# XHCI PCI->USB interface (USB 3.0)
device		usb		# USB Bus (required)
# HID was split into its own subsystem: uhid/ukbd now link against hid(4),
# so the bus and transport must be declared or the kernel fails to LINK with
# undefined hid_locate/hid_is_keyboard/etc. Nothing in the uhid line says so.
device		hid		# generic HID support
device		hidbus		# generic HID bus
device		usbhid		# USB HID transport

device		uhid		# "Human Interface Devices"
device		ukbd		# Keyboard
device		umass		# Disks/Mass storage - Requires scbus and da
# USB Serial devices
device		u3g		# USB-based 3G modems (Option, Huawei, Sierra)
# USB tty support
device		ucom		# Required by u3g
# USB Ethernet, requires miibus
device		aue		# ADMtek USB Ethernet
device		axe		# ASIX Electronics USB Ethernet
device		cdce		# Generic USB over Ethernet
device		cue		# CATC USB Ethernet
device		kue		# Kawasaki LSI USB Ethernet
device		rue		# RealTek RTL8150 USB Ethernet
device		udav		# Davicom DM9601E USB
# USB Wireless
device		rum		# Ralink Technology RT2501USB wireless NICs
device		ural		# Ralink Technology RT2500USB wireless NICs
device		zyd		# ZyDAS zb1211/zb1211b wireless NICs
device		run		# Ralink Technology RT2700U/RT2800U/RT3000U wireless NICs
