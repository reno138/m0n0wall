sbin/mdconfig
sbin/mdmfs
sbin/mount
sbin/mount_cd9660
sbin/mount_msdosfs
sbin/newfs
sbin/nologin
sbin/ping
sbin/ping6
sbin/reboot
sbin/route
sbin/shutdown
sbin/sysctl
sbin/umount

# contents of /usr/bin
usr/bin/gzip:usr/bin/gunzip
# grep, wc and id: for the Diagnostics > Command prompt page and for anyone
# working on the serial console. Nothing in the product calls them -- the PHP
# uses absolute paths to tools that were already here -- but their absence made
# the console and the exec page far less useful than they look, and it cost me
# an afternoon of wrongly suspecting popen() when a pipeline silently produced
# nothing. Every library all three need (libregex, libxo, libcasper,
# libcap_fileargs, libutil, libnv) is already in the image for other base tools,
# so this adds about 55KB of binaries and no new library closure.
usr/bin/grep:usr/bin/egrep:usr/bin/fgrep:usr/bin/rgrep
usr/bin/id
usr/bin/killall
usr/bin/logger
usr/bin/netstat
# usr/bin/nsupdate -- now from the bind-tools package, see stage 2
usr/bin/nohup
usr/bin/su
usr/bin/tail
usr/bin/tar
usr/bin/top
usr/bin/touch
usr/bin/uptime:usr/bin/w
usr/bin/wc

# contents of usr/sbin
# usr/sbin/ancontrol -- Aironet driver removed from FreeBSD
usr/sbin/arp
# syslogd and rtadvd were also built by stage 3 from patched sources. The
# syslogd patch added circular-log support for the GUI log viewer; the rtadvd
# patch only quietened DHCP-PD logging. Both use the base binaries now --
# see stage 3 for what became of the circular logging.
# UEFI NVRAM management: the installer registers the ESP as a boot entry
# rather than relying on the removable-media fallback path.
usr/sbin/efibootmgr
usr/sbin/efivar
usr/sbin/syslogd
# newsyslog bounds the log files. The port dropped the patched syslogd + clog
# ring buffers in favour of plain files "bounded by newsyslog(8)" (see
# build/files/newsyslog.conf and etc/rc), but the binary was never added to this
# manifest and nothing invoked it -- so /var/log grew without limit on a RAMDISK
# root until it filled memory.
usr/sbin/newsyslog
usr/sbin/rtadvd
usr/sbin/tcpdump
usr/sbin/chown
usr/sbin/chroot
usr/sbin/diskinfo
usr/sbin/hostapd
usr/sbin/ndp
usr/sbin/pwd_mkdb
usr/sbin/sntp
usr/sbin/traceroute
usr/sbin/traceroute6

# contents of /libexec
libexec/ld-elf.so.1
