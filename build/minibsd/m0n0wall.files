# contents of /usr/bin
#
# A usable shell: awk cut du find grep head id sed sort tr uname wc.
#
# Nothing in the product calls any of them -- the PHP invokes tools by absolute
# path and those were all already here -- so this is purely about what you get on
# the serial console and the Diagnostics > Command prompt page. Without them a
# pipeline silently produces nothing, because the shell's "not found" goes to a
# stderr that page does not capture; that cost me an afternoon of wrongly
# suspecting popen().
#
# Checked before adding rather than discovered by the ELF gate afterwards: every
# library the whole set needs (libregex, libxo, libcasper, libcap_fileargs,
# libutil, libnv) is already in the image for other base tools, so the library
# closure does not grow at all and the cost is just the binaries -- about 540KB,
# of which awk alone is 233KB.
#
# The a:b form hardlinks, as it does for halt/reboot: grep's egrep/fgrep/rgrep
# and awk's nawk are single inodes in base, and both binaries dispatch on
# argv[0].
usr/bin/awk:usr/bin/nawk
usr/bin/cut
usr/bin/du
usr/bin/find
usr/bin/grep:usr/bin/egrep:usr/bin/fgrep:usr/bin/rgrep
usr/bin/gzip:usr/bin/gunzip
usr/bin/head
usr/bin/id
usr/bin/killall
usr/bin/logger
usr/bin/netstat
# usr/bin/nsupdate -- now from the bind-tools package, see stage 2
usr/bin/nohup
usr/bin/sed
usr/bin/sort
usr/bin/su
usr/bin/tail
usr/bin/tar
usr/bin/top
usr/bin/touch
usr/bin/tr
usr/bin/uname
usr/bin/uptime:usr/bin/w
usr/bin/wc

# contents of usr/sbin
# usr/sbin/ancontrol -- Aironet driver removed from FreeBSD
usr/sbin/arp
# syslogd and rtadvd were also built by stage 3 from patched sources. The
# syslogd patch added circular-log support for the GUI log viewer; the rtadvd
# patch only quietened DHCP-PD logging. Both use the base binaries now --
# see stage 3 for what became of the circular logging.
# UEFI NVRAM management: the installer registers the ESP as a boot entry
# rather than relying on the removable-media fallback path.
usr/sbin/efibootmgr
usr/sbin/efivar
usr/sbin/syslogd
# newsyslog bounds the log files. The port dropped the patched syslogd + clog
# ring buffers in favour of plain files "bounded by newsyslog(8)" (see
# build/files/newsyslog.conf and etc/rc), but the binary was never added to this
# manifest and nothing invoked it -- so /var/log grew without limit on a RAMDISK
# root until it filled memory.
usr/sbin/newsyslog
usr/sbin/rtadvd
usr/sbin/tcpdump
usr/sbin/chown
usr/sbin/chroot
usr/sbin/diskinfo
usr/sbin/hostapd
usr/sbin/ndp
usr/sbin/pwd_mkdb
usr/sbin/sntp
usr/sbin/traceroute
usr/sbin/traceroute6

