# --- added for FreeBSD 15 -------------------------------------------------
# ifconfig was previously BUILT by stage 3, patched for a FreeBSD 8 IPv6
# default-route bug (r222728) that has long since been fixed upstream. The
# base binary is used now, so the manifest has to list it -- without this the
# image has no ifconfig at all, and interfaces.inc calls it 59 times.
sbin/ifconfig
# pf replaces ipfilter. pfctl configures it; pflogd writes the pflog0 capture.
sbin/pfctl
sbin/pflogd
# GPT tooling: the installer runs 'gpart recover' after dd'ing the image onto
# a larger disk, and diag pages report partitioning.
sbin/gpart
sbin/kldstat
sbin/dhclient
sbin/devd
