# All rights reserved.

# make sure the user can't kill us by pressing Ctrl-C
trap : 2
trap : 3

# redirect input/output
exec </dev/console >/dev/console 2>/dev/console

if [ -r /var/etc/disableconsole ]; then

while : ; do

echo
echo
echo "*** Console menu disabled. ***"
echo

read tmp

done

else 

# endless loop
while : ; do

/etc/rc.banner

# display a cheap menu
echo
echo
echo "m0n0wall console setup"
echo "**********************"
echo "1) Interfaces: assign network ports"
echo "2) Set up LAN IP address"
echo "3) Reset webGUI password"
echo "4) Reset to factory defaults"
echo "5) Reboot system"
echo "6) Ping host"
# Offer the installer on any CD platform. This used to test for exactly
# "generic-pc-cdrom"; adding the serial-console ISO introduced a second CD
# platform, "generic-pc-serial-cdrom", and an exact match silently dropped
# option 7 from the menu -- the installer was present and simply unreachable.
PLATFORM=`cat /etc/platform`
case "$PLATFORM" in
*-cdrom)
	echo "7) Install on Hard Drive"
	;;
esac
# Development builds only (MW_DEVBUILD=1 at build time writes the marker).
# m0n0wall never offered a shell and release images still don't; during
# bring-up it is the difference between reading /var/log/system.log and
# guessing at it.
if [ -f /etc/devbuild ]; then
	echo "8) Shell (development build)"
fi
echo

read -p "Enter a number: " opmode

# see what the user has chosen
case ${opmode} in
1)
	/etc/rc.initial.setports
 	;;
2)
	/etc/rc.initial.setlanip
 	;;
3)
	/etc/rc.initial.password
	;;
4)
	/etc/rc.initial.defaults
	;;
5)
	/etc/rc.initial.reboot
	;;
6)
	/etc/rc.initial.ping
	;;
7)
	case "$PLATFORM" in
	*-cdrom)
		/etc/rc.initial.install
		;;
	esac
	;;
8)
	if [ -f /etc/devbuild ]; then
		echo
		echo "Development build: root shell. 'exit' returns to this menu."
		# Reset the SIGINT/SIGQUIT traps this script sets. Without this the
		# shell inherits them as IGNORED, so Ctrl-C does nothing in it -- and
		# an unterminated quote or a blocking command leaves the console stuck
		# at a '>' prompt with no way out but a reboot.
		( trap - 2 3
		  PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
		  export PATH
		  exec /bin/sh )
	fi
	;;
esac

done

fi
