# All rights reserved.

# make sure the user can't kill us by pressing Ctrl-C
trap : 2
trap : 3

# redirect input/output
exec </dev/console >/dev/console 2>/dev/console

if [ -r /var/etc/disableconsole ]; then

while : ; do

echo
echo
echo "*** Console menu disabled. ***"
echo

read tmp

done

else 

# endless loop
while : ; do

/etc/rc.banner

# display a cheap menu
echo
echo
echo "m0n0wall console setup"
echo "**********************"
echo "1) Interfaces: assign network ports"
echo "2) Set up LAN IP address"
echo "3) Reset webGUI password"
echo "4) Reset to factory defaults"
echo "5) Reboot system"
echo "6) Ping host"
# Offer the installer on any CD platform. This used to test for exactly
# "generic-pc-cdrom"; adding the serial-console ISO introduced a second CD
# platform, "generic-pc-serial-cdrom", and an exact match silently dropped
# option 7 from the menu -- the installer was present and simply unreachable.
PLATFORM=`cat /etc/platform`
case "$PLATFORM" in
*-cdrom)
	echo "7) Install on Hard Drive"
	;;
esac
echo

read -p "Enter a number: " opmode

# see what the user has chosen
case ${opmode} in
1)
	/etc/rc.initial.setports
 	;;
2)
	/etc/rc.initial.setlanip
 	;;
3)
	/etc/rc.initial.password
	;;
4)
	/etc/rc.initial.defaults
	;;
5)
	/etc/rc.initial.reboot
	;;
6)
	/etc/rc.initial.ping
	;;
7)
	case "$PLATFORM" in
	*-cdrom)
		/etc/rc.initial.install
		;;
	esac
	;;
esac

done

fi
