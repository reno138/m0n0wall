#!/bin/sh

# $Id$
# part of m0n0wall (http://m0n0.ch/wall)
#
# Copyright (C) 2003-2005 Manuel Kasper <mk@neon1.net>.
# All rights reserved.

CFDEVICE=`cat /var/etc/cfdevice`

if [ $1 != "upgrade" ]; then
	/sbin/umount -f /ftmp > /dev/null 2>&1
	/sbin/mdconfig -d -u 1 > /dev/null 2>&1
fi

case $1 in
enable)
	# Holds the uploaded image. 16m fitted a 2015 image; the image is ~41 MB
	# now, and an upload transiently needs THREE copies here: lighttpd's spooled
	# request body, php-cgi's own copy of the upload, and the final
	# firmware.img. Keep this comfortably above 3x the image and above
	# upload_max_filesize in php.ini. Fetching from a URL would need one copy;
	# see the plan.
	#
	# Fail loudly: the webGUI checks this exit status (and that /ftmp really
	# is a separate filesystem) before it offers the upload form.
	if ! /sbin/mdmfs -s 192m md1 /ftmp > /tmp/rc.firmware.err 2>&1; then
		# user.err, not logger's default user.notice, which syslog.conf does
		# not route to system.log; and to stderr as well, so the webGUI's
		# firmware_rc() carries the reason in its own log line
		/usr/bin/logger -p user.err -t rc.firmware "enable: could not create the upload RAM disk: `cat /tmp/rc.firmware.err`"
		cat /tmp/rc.firmware.err >&2
		exit 1
	fi
	;;
upgrade)
	# wait 5 seconds before beginning
	sleep 5

	exec </dev/console >/dev/console 2>/dev/console

	echo
	echo "Firmware upgrade in progress..."

	# backup config
	mkdir /tmp/configbak
	cp -p /conf/* /tmp/configbak

	# The persistent data partition (datadisk.inc) sits at the end of the
	# disk, past anything an image within budget reaches. The dd below
	# rewrites the partition table from the image, which has no entry for it:
	# record where it is, release it, and put the entry back afterwards. Its
	# contents are never written.
	DATAPART=`/sbin/gpart show -p -l $CFDEVICE 2>/dev/null | /usr/bin/awk '$4 == "m0n0data" { idx = $3; sub(/.*p/, "", idx); print $1, $2, idx }'`
	if [ -n "$DATAPART" ]; then
		echo "Releasing the data partition..."
		/usr/bin/killall syslogd pflogd > /dev/null 2>&1
		sleep 1
		/sbin/umount -f /data > /dev/null 2>&1
	fi

	# unmount /cf
	/sbin/umount -f /cf

	# dd image onto card
	if [ -r $2 ]; then
		/usr/bin/gunzip -S "" -c $2 | dd of=/dev/$CFDEVICE ibs=64k obs=64k > /dev/null 2>/tmp/dd.err
		# The image is GPT and sized for its own content, so on any larger disk
		# the backup header is not at the last LBA. Rewrite it, as the installer
		# does, or every boot warns and some firmware refuses the table.
		/sbin/gpart recover $CFDEVICE > /dev/null 2>&1
		echo "Image installed."

		# Put the data partition's entry back, exactly where it was -- but
		# only if the image ended before it. dd's own byte count says how far
		# it wrote (gzip -l cannot: the signature follows the gzip data).
		if [ -n "$DATAPART" ]; then
			DSTART=`echo $DATAPART | /usr/bin/awk '{print $1}'`
			DSIZE=`echo $DATAPART | /usr/bin/awk '{print $2}'`
			DIDX=`echo $DATAPART | /usr/bin/awk '{print $3}'`
			SECT=`/sbin/gpart list $CFDEVICE | /usr/bin/awk '/Sectorsize/ { print $2; exit }'`
			IMGBYTES=`/usr/bin/awk '/bytes transferred/ { print $1 }' /tmp/dd.err`
			if [ -n "$IMGBYTES" ] && [ $(( IMGBYTES / ${SECT:-512} )) -lt $DSTART ]; then
				/sbin/gpart add -i $DIDX -b $DSTART -s $DSIZE -t freebsd-ufs -l m0n0data $CFDEVICE > /dev/null 2>&1 \
					&& echo "Data partition kept." \
					|| echo "WARNING: could not restore the data partition entry."
			else
				echo "WARNING: the image reaches into the data partition; it will be re-created empty."
			fi
		fi
	fi

	# mount /cf
	/sbin/mount -w -o noatime /cf

	# restore config
	cp -p /tmp/configbak/* /conf

	# remount /cf ro
	/sbin/umount -f /cf
	/sbin/mount -r /cf

	echo "Done - rebooting system..."

	# unset CGI environment variables so as not to confuse PHP
	unset CONTENT_TYPE GATEWAY_INTERFACE REMOTE_USER REMOTE_ADDR AUTH_TYPE
	unset HTTP_USER_AGENT CONTENT_LENGTH SCRIPT_FILENAME HTTP_HOST
	unset SERVER_SOFTWARE HTTP_REFERER SERVER_PROTOCOL REQUEST_METHOD
	unset SERVER_PORT SCRIPT_NAME SERVER_NAME

	/etc/rc.cleanreboot
	;;
esac
