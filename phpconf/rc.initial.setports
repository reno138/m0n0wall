	/* parse the configuration and include all functions used below */
	require_once("config.inc");
	require_once("functions.inc");
	
	$fp = fopen('php://stdin', 'r');
	
	$iflist = get_interface_list(true, false, false);
	
	echo <<<EOD

Valid interfaces are:


EOD;

	foreach ($iflist as $iface => $ifa) {
		/* ?? '': a wg(4) tunnel is in the list with no driver name, which
		   printed a PHP warning into the middle of the table */
		echo sprintf("% -8s%s% 7s   %s\n", $iface, $ifa['mac'] ?? '',
			!empty($ifa['up']) ? "(up)" : "", $ifa['drvname'] ?? '');
	}
	
	echo <<<EOD

Note that wireless LAN interfaces are not included in the list above;
they can be set up through the webGUI later on.

Do you want to set up VLANs first?
If you're not going to use VLANs, or only for optional interfaces, you
should say no here and use the webGUI to configure VLANs later, if required.

Do you want to set up VLANs now? (y/n) 
EOD;
	
	if (strcasecmp(chop(fgets($fp)), "y") == 0)
		vlan_setup();
	
	if (is_array($config['vlans']['vlan']) && count($config['vlans']['vlan'])) {
		
		echo "\n\nVLAN interfaces:\n\n";
		$i = 0;
		foreach ($config['vlans']['vlan'] as $vlan) {
			
			echo sprintf("% -8s%s\n", "vlan{$i}",
				"VLAN tag {$vlan['tag']}, interface {$vlan['if']}");
				
			$iflist['vlan' . $i] = array();
			$i++;
		}
	}
	
	echo <<<EOD

If you don't know the names of your interfaces, you may choose to use
auto-detection. In that case, disconnect all interfaces before you begin,
and reconnect each one when prompted to do so.

EOD;
	
	do {
		echo "\nEnter the LAN interface name or 'a' for auto-detection: ";
		$lanif = chop(fgets($fp));
		if ($lanif === "") {
			exit(0);
		}
		
		if ($lanif === "a")
			$lanif = autodetect_interface("LAN", $fp);
		else if (!array_key_exists($lanif, $iflist)) {
			echo "\nInvalid interface name '{$lanif}'\n";
			unset($lanif);
			continue;
		}
	} while (!$lanif);
	
	do {
		echo "\nEnter the WAN interface name or 'a' for auto-detection: ";
		$wanif = chop(fgets($fp));
		if ($wanif === "") {
			exit(0);
		}
		if ($wanif === "a")
			$wanif = autodetect_interface("WAN", $fp);
		else if (!array_key_exists($wanif, $iflist)) {
			echo "\nInvalid interface name '{$wanif}'\n";
			unset($wanif);
			continue;
		}
	} while (!$wanif);
	
	/* optional interfaces */
	$i = 0;
	$optif = array();
	
	while (1) {
		/* ?? '': on the first pass there is no entry yet */
		if ($optif[$i] ?? '')
			$i++;
		$i1 = $i + 1;
		echo "\nEnter the Optional {$i1} interface name or 'a' for auto-detection\n" .
			"(or nothing if finished): ";
		$optif[$i] = chop(fgets($fp));
		
		if ($optif[$i]) {
			if ($optif[$i] === "a") {
				$ad = autodetect_interface("Optional " . $i1, $fp);
				if ($ad)
					$optif[$i] = $ad;
				else
					unset($optif[$i]);
			} else if (!array_key_exists($optif[$i], $iflist)) {
				echo "\nInvalid interface name '{$optif[$i]}'\n";
				unset($optif[$i]);
				continue;
			}
		} else {
			unset($optif[$i]);
			break;
		}
	}
	
	/* check for double assignments */
	$ifarr = array_merge(array($lanif, $wanif), $optif);
	
	for ($i = 0; $i < (count($ifarr)-1); $i++) {
		for ($j = ($i+1); $j < count($ifarr); $j++) {
			if ($ifarr[$i] == $ifarr[$j]) {
				echo <<<EOD
	
Error: you can't assign the same interface name twice!

EOD;

				exit(0);
			}
		}
	}
	
	/* Which optional interface gets which port. The ports just entered go to the
	   interfaces that already exist, in number order, so each keeps its name and
	   therefore its DHCP section, its rules, its secondary addresses and its
	   scheduler jobs; surplus ports become new interfaces at the lowest free
	   number; interfaces left without a port are deleted below, with their
	   dependent config. The reasoning, and what this replaces, is at
	   opt_assign_map() in phpconf/inc/optif.inc. */
	$assign  = opt_assign_map($optif);
	$optmap  = $assign['map'];
	$surplus = $assign['surplus'];
	
	/* IPv6. Asked here -- once the ports are settled, before the summary -- so
	   the answers are shown with everything else and saved by the same "y".
	   null means "leave IPv6 exactly as it is". */
	$v6plan = ipv6_setup($fp, $optmap);
	
	echo <<<EOD
	
The interfaces will be assigned as follows:

LAN  -> {$lanif}
WAN  -> {$wanif}

EOD;

	/* The real names, not a 1..n count: if the interfaces are opt1 and opt3 then
	   that is what this has to say, or the admin is shown one mapping and given
	   another. */
	foreach ($optmap as $optname => $optdev)
		echo strtoupper($optname) . " -> " . $optdev . "\n";
	
	foreach ($surplus as $optname)
		echo strtoupper($optname) . " -> (removed, with its DHCP server and " .
			"any rules that name it)\n";
	
	if ($v6plan !== null) {
		echo "\nIPv6 will be enabled:\n";
		echo "WAN  " . ipv6_describe($v6plan['wan']) . "\n";
		echo "LAN  " . ipv6_describe($v6plan['lan']) . "\n";
		foreach ($v6plan['opt'] as $optname => $keys)
			echo str_pad(strtoupper($optname), 5) . ipv6_describe($keys) . "\n";
	}

echo <<<EOD

The firewall will reboot after saving the changes.

Do you want to proceed? (y/n) 
EOD;
	
	if (strcasecmp(chop(fgets($fp)), "y") == 0) {
	
		$config['interfaces']['lan']['if'] = $lanif;
		if (preg_match($g['wireless_regex'], $lanif)) {
			if (!is_array($config['interfaces']['lan']['wireless']))
				$config['interfaces']['lan']['wireless'] = array();
		} else {
			unset($config['interfaces']['lan']['wireless']);
		}
		
		$config['interfaces']['wan']['if'] = $wanif;
		if (preg_match($g['wireless_regex'], $wanif)) {
			if (!is_array($config['interfaces']['wan']['wireless']))
				$config['interfaces']['wan']['wireless'] = array();
		} else {
			unset($config['interfaces']['wan']['wireless']);
		}
		
		foreach ($optmap as $optname => $optdev) {
			$isnew = !is_array($config['interfaces'][$optname] ?? null);
			if ($isnew)
				$config['interfaces'][$optname] = array();
			
			$config['interfaces'][$optname]['if'] = $optdev;
			
			/* wireless interface? */
			if (preg_match($g['wireless_regex'], $optdev)) {
				if (!is_array($config['interfaces'][$optname]['wireless'] ?? null))
					$config['interfaces'][$optname]['wireless'] = array();
			} else {
				unset($config['interfaces'][$optname]['wireless']);
			}
			
			/* Left disabled deliberately, as before: the port underneath this
			   interface has just changed, so its address may no longer belong to
			   the network it is now plugged into, and the admin has to look. */
			unset($config['interfaces'][$optname]['enable']);
			
			/* The description is the admin's, and is only set for an interface
			   that did not exist a moment ago. This used to overwrite every one
			   of them with "OPTn", which is how an admin first discovered their
			   interfaces had been renamed under them. */
			if ($isnew)
				$config['interfaces'][$optname]['descr'] = strtoupper($optname);
		}
		
		/* The optional interfaces left without a port. opt_iface_delete() takes
		   the configuration that belonged to each with it -- its DHCP server,
		   its DHCP relay, its secondary addresses and its scheduler jobs -- so
		   nothing is left behind for a later add to inherit when it reuses the
		   number. */
		foreach ($surplus as $optname)
			opt_iface_delete($optname);
		
		if ($v6plan !== null)
			ipv6_plan_apply($config, $v6plan);
		
		write_config();
		
		echo <<<EOD

The firewall is rebooting now.

EOD;
	
		system_reboot_sync();
	}
	
	function autodetect_interface($ifname, $fp) {
		$iflist_prev = get_interface_list(true, false, false);
		echo <<<EOD

Connect the {$ifname} interface now and make sure that the link is up.
Then press ENTER to continue.

EOD;
		fgets($fp);
		$iflist = get_interface_list(true, false, false);
		
		foreach ($iflist_prev as $ifn => $ifa) {
			if (!$ifa['up'] && $iflist[$ifn]['up']) {
				echo "Detected link-up on interface {$ifn}.\n";
				return $ifn;
			}
		}
		
		echo "No link-up detected.\n";
		
		return null;
	}
	
	function vlan_setup() {
		global $iflist, $config, $g, $fp;
		
		if (is_array($config['vlans']['vlan']) && count($config['vlans']['vlan'])) {
		
		echo <<<EOD

WARNING: all existing VLANs will be cleared if you proceed!

Do you want to proceed? (y/n) 
EOD;
	
		if (strcasecmp(chop(fgets($fp)), "y") != 0)
			return;
		}
		
		$config['vlans']['vlan'] = array();
		echo "\n";
		
		while (1) {
			$vlan = array();
			
			echo "\nEnter the parent interface name for the new VLAN (or nothing if finished): ";
			$vlan['if'] = chop(fgets($fp));
			
			if ($vlan['if']) {
				if (!array_key_exists($vlan['if'], $iflist)) {
					echo "\nInvalid interface name '{$vlan['if']}'\n";
					continue;
				}
			} else {
				break;
			}
			
			echo "Enter the VLAN tag (1-4094): ";
			$vlan['tag'] = chop(fgets($fp));
			
			if (!is_numericint($vlan['tag']) || ($vlan['tag'] < 1) || ($vlan['tag'] > 4094)) {
				echo "\nInvalid VLAN tag '{$vlan['tag']}'\n";
				continue;
			}
			
			$config['vlans']['vlan'][] = $vlan;
		}
	}

	/* Ask for an IPv6 address until one is given, or nothing when $optional. */
	function ipv6_ask_addr($fp, $prompt, $optional = false) {
		while (true) {
			echo $prompt . ($optional ? " (or nothing for none)" : "") . ": ";
			$a = chop(fgets($fp));
			if ($a === "" && $optional)
				return "";
			if (is_ipaddr6($a))
				return $a;
			echo "'{$a}' is not an IPv6 address.\n";
		}
	}
	
	function ipv6_ask_number($fp, $prompt, $default, $min, $max) {
		while (true) {
			echo "{$prompt} [{$default}]: ";
			$n = chop(fgets($fp));
			if ($n === "")
				return (string)$default;
			if (ctype_digit($n) && (int)$n >= $min && (int)$n <= $max)
				return (string)(int)$n;
			echo "Enter a number from {$min} to {$max}.\n";
		}
	}
	
	function ipv6_ask_choice($fp, $valid) {
		while (true) {
			echo "Choose " . implode(", ", $valid) . ": ";
			$c = chop(fgets($fp));
			if (in_array($c, $valid, true))
				return $c;
		}
	}
	
	/* One line for the summary, from an interface's part of the plan. */
	function ipv6_describe($keys) {
		if (empty($keys))
			return "no IPv6";
		if (($keys['ipaddr6'] ?? '') === 'DHCP')
			return "DHCPv6 from the upstream router";
		if (($keys['ipaddr6'] ?? '') === 'DHCP-PD')
			$d = "prefix delegated through WAN (a /" . (64 - (int)$keys['slalen']) .
			     " from the ISP, subnet " . ($keys['slaid'] ?? '0') . ")";
		else
			$d = "{$keys['ipaddr6']}/{$keys['subnet6']}";
		if (!empty($keys['gateway6']))
			$d .= ", gateway {$keys['gateway6']}";
		if (!empty($keys['ipv6ra']))
			$d .= ", router advertisements on";
		return $d;
	}
	
	/* The IPv6 dialog. Returns a plan for ipv6_plan_apply(), or null to leave
	   IPv6 untouched. Offers what is set up most often -- static addresses, and
	   DHCPv6 with prefix delegation from the ISP; 6to4 and tunnel brokers are in
	   the webGUI. */
	function ipv6_setup($fp, $optmap) {
		global $config;
		
		$on = isset($config['system']['enableipv6']);
		echo "\n\nIPv6 is currently " . ($on ? "enabled" : "disabled") . ".\n";
		echo "Do you want to set up IPv6 now? (y/n; n leaves it as it is) ";
		if (strcasecmp(chop(fgets($fp)), "y") != 0)
			return null;
		
		$plan = array('wan' => array(), 'lan' => array(), 'opt' => array());
		
		/* --- WAN --- */
		$wantype = $config['interfaces']['wan']['ipaddr'] ?? '';
		$dhcp6ok = ($wantype === 'dhcp' || is_ipaddr($wantype));
		echo "\nIPv6 on WAN:\n";
		echo "  1) Static address\n";
		echo "  2) DHCPv6 from the upstream router, with prefix delegation\n";
		echo "  3) None\n";
		while (true) {
			$c = ipv6_ask_choice($fp, array('1', '2', '3'));
			if ($c !== '2' || $dhcp6ok)
				break;
			/* the webGUI enforces the same: dhcp6c runs beside dhclient or a
			   static address, not over PPPoE/PPTP/modem links */
			echo "DHCPv6 needs WAN's IPv4 to be static or DHCP; it is '{$wantype}'.\n" .
			     "Change that in the webGUI first, or choose another option.\n";
		}
		if ($c === '1') {
			$plan['wan']['ipaddr6']  = ipv6_ask_addr($fp, "WAN IPv6 address");
			$plan['wan']['subnet6']  = ipv6_ask_number($fp, "WAN IPv6 prefix length", 64, 1, 128);
			$plan['wan']['gateway6'] = ipv6_ask_addr($fp, "WAN IPv6 gateway");
		} else if ($c === '2') {
			$plan['wan']['ipaddr6'] = 'DHCP';
		}
		$wanpd = ($c === '2');
		
		/* --- LAN --- */
		echo "\nIPv6 on LAN:\n";
		echo "  1) Static address\n";
		if ($wanpd)
			echo "  2) A prefix delegated by the ISP through WAN DHCPv6\n";
		echo "  3) None\n";
		$c = ipv6_ask_choice($fp, $wanpd ? array('1', '2', '3') : array('1', '3'));
		if ($c === '1') {
			$plan['lan']['ipaddr6'] = ipv6_ask_addr($fp, "LAN IPv6 address");
			$plan['lan']['subnet6'] = ipv6_ask_number($fp, "LAN IPv6 prefix length", 64, 1, 128);
		} else if ($c === '2') {
			/* The same two numbers the LAN page asks for: how big a prefix the
			   ISP hands out, and which /64 of it LAN takes. */
			$ispfx = ipv6_ask_number($fp, "Prefix length your ISP delegates", 56, 48, 64);
			$plan['lan']['ipaddr6'] = 'DHCP-PD';
			$plan['lan']['slalen']  = (string)(64 - (int)$ispfx);
			$maxid = (1 << (64 - (int)$ispfx)) - 1;
			$plan['lan']['slaid']   = ipv6_ask_number($fp,
				"Which /64 of it LAN uses (0 to {$maxid})", 0, 0, $maxid);
		}
		if (!empty($plan['lan'])) {
			echo "Send router advertisements on LAN, so hosts configure " .
			     "themselves? (y/n) ";
			if (strcasecmp(chop(fgets($fp)), "y") == 0) {
				$plan['lan']['ipv6ra'] = true;
				if (($plan['lan']['subnet6'] ?? '64') !== '64')
					echo "Note: hosts can only configure themselves from a /64.\n";
			}
		}
		
		/* --- optional interfaces: static only; the rest is in the webGUI --- */
		foreach ($optmap as $optname => $optdev) {
			$a = ipv6_ask_addr($fp, "\nIPv6 address for " . strtoupper($optname) .
				" ({$optdev})", true);
			$plan['opt'][$optname] = ($a === "") ? array() : array(
				'ipaddr6' => $a,
				'subnet6' => ipv6_ask_number($fp, strtoupper($optname) .
					" IPv6 prefix length", 64, 1, 128));
		}
		
		return $plan;
	}
?>
