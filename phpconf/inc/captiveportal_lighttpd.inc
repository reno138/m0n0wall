/* ===========================================================================
 * The captive portal was the only real reason m0n0wall patched mini_httpd.
 *
 * Of the 563-line local patch, two features existed solely for this:
 *
 *   -maxperip N          cap concurrent connections per client address, so
 *                        one machine cannot exhaust the portal
 *   -cpelement PATH HOST serve a directory for one particular vhost, which
 *                        is how uploaded portal images and stylesheets are
 *                        served alongside the generated login page
 *
 * Both are ordinary configuration in lighttpd, so the patch disappears
 * entirely -- and with it the obligation to forward-port a 563-line diff
 * against a web server whose upstream has been quiet since 2018.
 *
 *   -cpelement           -> a $HTTP["host"] conditional with its own
 *                           document root
 *   -maxperip            -> pf, NOT lighttpd. mod_evasive was the obvious
 *                           destination and lighttpd 1.4.84 no longer ships
 *                           it (its own documentation calls it deprecated in
 *                           favour of a lua implementation). Since pf is
 *                           already running, the cap moved to the rule that
 *                           permits access to the portal, as
 *                           "max-src-conn N". That is where connection
 *                           limiting belongs: it drops the connection before
 *                           a worker is ever allocated, instead of after.
 *                           See pf_captiveportal_rules_generate().
 *
 * Two servers are still run, on 8000 and 8001, because the portal must
 * answer both plain HTTP and HTTPS and they need different certificates and
 * hostnames. That is unchanged.
 * ===========================================================================
 */

/* Generate the captive portal's lighttpd configuration.
 *
 * $https selects the TLS instance (port 8001) rather than the plain one
 * (8000). Returned as text so it can be unit-tested.
 */
function captiveportal_lighttpd_config_generate($https = false) {
	global $config, $g;

	$cp   = isset($config['captiveportal']) ? $config['captiveportal'] : array();
	$port = $https ? 8001 : 8000;
	$tag  = $https ? "cps" : "cp";

	$cpip = isset($config['interfaces'][$cp['interface']]['ipaddr'])
	        ? $config['interfaces'][$cp['interface']]['ipaddr'] : '';
	$vhost = $https
	         ? (!empty($cp['httpsname']) ? $cp['httpsname'] : $cpip)
	         : $cpip;

	/* Concurrency limits. The portal is reachable by anyone on the captive
	   network before they have authenticated, so these are the only thing
	   standing between one client and the whole process pool. */
	$maxproc = !empty($cp['maxproc']) ? $cp['maxproc'] : 16;

	$out  = "# Captive portal ({$tag}) -- generated by m0n0wall.\n\n";

	/* mod_alias and mod_accesslog must be named even though lighttpd builds
	   them in: an unnamed module means its directives are silently IGNORED,
	   not rejected. For alias.url that means the portal serves no images and
	   no stylesheet, and looks merely ugly rather than broken. */
	$out .= "server.modules = (\n";
	$out .= "\t\"mod_alias\",\n";
	$out .= "\t\"mod_accesslog\",\n";
	$out .= "\t\"mod_fastcgi\",\n";
	if ($https)
		$out .= "\t\"mod_openssl\",\n";
	$out .= ")\n\n";

	$out .= "server.document-root = \"{$g['captiveportal_path']}\"\n";
	$out .= "server.port          = {$port}\n";
	/* Bind the LOOPBACK, not the portal interface.
	
	   captiveportal.inc intercepts unauthenticated web traffic with
	   'ipfw ... fwd 127.0.0.1,8000', which rewrites the packet's destination to
	   the loopback -- so a server bound only to the interface address has no
	   socket for the redirected connection to land on and every intercepted
	   request was refused. That is the entire point of the portal, so it was
	   dead rather than degraded.
	
	   The interface address is still needed: index.php bounces the client to
	   http://<cpip>:8000/?redirurl=... and the client then connects there
	   directly. So both are listened on, and nothing else is -- binding
	   0.0.0.0 would expose the portal on the WAN. */
	$out .= "server.bind          = \"127.0.0.1\"\n";
	$out .= "server.pid-file      = \"{$g['varrun_path']}/lighttpd.{$tag}.pid\"\n";
	$out .= "server.errorlog      = \"{$g['varlog_path']}/portalauth.log\"\n";
	$out .= "server.indexfiles    = ( \"index.php\" )\n";
	/* An intercepted client asked for some other site's URL, so the path is
	   almost never "/" -- it is "/news/index.html" or whatever they clicked.
	   Without this every one of those got lighttpd's 404 page instead of the
	   login page. mini_httpd's captive mode forced all non-element requests to
	   index.php; this is the lighttpd spelling of that, and it preserves the
	   original URL in REQUEST_URI so index.php can redirect the client back to
	   where they were going. */
	$out .= "server.error-handler-404 = \"/index.php\"\n";
	/* max-CONNECTIONS, not max-worker.
	
	   The GUI calls this "total maximum number of concurrent connections" and
	   validates it to 4..100. server.max-worker is a count of FORKED lighttpd
	   worker processes, so the documented meaning was lost and a perfectly
	   legal value of 100 would have forked 100 processes on a machine chosen
	   for being small. server.max-connections is the directive that means what
	   the page says. */
	$out .= "server.max-connections = {$maxproc}\n";
	/* An unauthenticated client should not be able to post megabytes. */
	$out .= "server.max-request-size = 256\n";
	$out .= "accesslog.filename   = \"/dev/null\"\n\n";

	/* The per-IP connection cap lives in pf, not here -- see the header. */

	$out .= "mimetype.assign = (\n";
	$out .= "\t\".html\" => \"text/html\", \".htm\" => \"text/html\",\n";
	$out .= "\t\".css\" => \"text/css\", \".js\" => \"text/javascript\",\n";
	$out .= "\t\".gif\" => \"image/gif\", \".png\" => \"image/png\",\n";
	$out .= "\t\".jpg\" => \"image/jpeg\", \".jpeg\" => \"image/jpeg\",\n";
	$out .= "\t\"\" => \"application/octet-stream\"\n";
	$out .= ")\n\n";

	$out .= "fastcgi.server = ( \".php\" =>\n";
	$out .= "\t(( \"socket\"   => \"{$g['varrun_path']}/php-cp-{$tag}.socket\",\n";
	$out .= "\t   \"bin-path\" => \"/usr/local/bin/php-cgi\",\n";
	$out .= "\t   \"max-procs\" => 2,\n";
	$out .= "\t   \"bin-environment\" => ( \"PHP_FCGI_CHILDREN\" => \"4\" ),\n";
	$out .= "\t   \"broken-scriptfilename\" => \"enable\"\n";
	$out .= "\t))\n";
	$out .= ")\n\n";

	/* Uploaded portal elements -- logos, stylesheets -- live outside the
	   document root. This is what mini_httpd's -cpelement did.
	
	   One alias per uploaded file, at the ROOT of the URL space, because that
	   is what the file manager tells the user to write:
	
	       <img src="test.jpg">
	
	   The previous "/captiveportal-" prefix was invented here and matched
	   neither the GUI's instructions nor mini_httpd, so every uploaded logo and
	   stylesheet 404'd and portal pages rendered unstyled. A per-file alias is
	   used rather than aliasing "/" itself, which would shadow index.php. */
	if (isset($config['captiveportal']['element'])
	    && is_array($config['captiveportal']['element'])) {
		$aliases = "";
		foreach ($config['captiveportal']['element'] as $element) {
			if (empty($element['name']))
				continue;
			/* The file manager already rejects a name with a path in it; this
			   is the second line of defence, since an alias pointing out of
			   the element directory would serve arbitrary files. */
			$name = basename($element['name']);
			if ($name === '' || $name[0] === '.')
				continue;
			$aliases .= "\talias.url += ( \"/" . $name . "\" => \"" .
			            "{$g['captiveportal_element_path']}/" . $name . "\" )\n";
		}
		if ($aliases !== "") {
			$out .= "# was mini_httpd's -cpelement: uploaded portal content\n";
			$out .= $aliases . "\n";
		}
	}

	if ($https) {
		$out .= "ssl.engine  = \"enable\"\n";
		$out .= "ssl.pemfile = \"{$g['varetc_path']}/cert-portal.pem\"\n";
		$out .= "ssl.openssl.ssl-conf-cmd = ( \"MinProtocol\" => \"TLSv1.2\" )\n\n";
	}

	/* The second listener: the address index.php sends the client to, and the
	   one the 'pass tcp from any to $cpip 8000' ipfw rules already allow. TLS
	   has to be re-stated because lighttpd enables it per socket. */
	if ($cpip !== '') {
		$out .= "# the address index.php redirects the client to\n";
		$out .= "\$SERVER[\"socket\"] == \"{$cpip}:{$port}\" {\n";
		if ($https) {
			$out .= "\tssl.engine  = \"enable\"\n";
			$out .= "\tssl.pemfile = \"{$g['varetc_path']}/cert-portal.pem\"\n";
		}
		$out .= "}\n\n";
	}

	return $out;
}

/* Start (or restart) the portal servers. Replaces the mini_httpd half of
 * captiveportal_configure().
 */
function captiveportal_lighttpd_start() {
	global $config, $g;

	$cp = isset($config['captiveportal']) ? $config['captiveportal'] : array();

	foreach (array(false, true) as $https) {
		$tag = $https ? "cps" : "cp";

		killbypid("{$g['varrun_path']}/lighttpd.{$tag}.pid");
		/* stale pidfiles from a pre-upgrade config */
		killbypid("{$g['varrun_path']}/mini_httpd.{$tag}.pid");

		if ($https && !(isset($cp['httpslogin']) && !empty($cp['certificate'])
		                && !empty($cp['private-key'])))
			continue;

		$conf = "{$g['varetc_path']}/lighttpd-{$tag}.conf";
		$old = umask(0077);
		file_put_contents($conf, captiveportal_lighttpd_config_generate($https));
		umask($old);

		$out = array(); $rc = 0;
		exec(LIGHTTPD_BIN . " -tt -f " . escapeshellarg($conf) . " 2>&1", $out, $rc);
		if ($rc != 0) {
			printf("Captive portal (%s): generated config is invalid:\n%s\n",
			       $tag, implode("\n", $out));
			continue;
		}
		mwexec(LIGHTTPD_BIN . " -f " . escapeshellarg($conf));
	}

	return 0;
}
