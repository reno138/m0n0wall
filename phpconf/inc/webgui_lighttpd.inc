/* ===========================================================================
 * Why lighttpd
 *
 * m0n0wall ran mini_httpd, carrying a 563-line local patch against it. Two of
 * that patch's features exist only for the captive portal (-maxperip, and
 * -cpelement to serve one path for a particular vhost) and both are ordinary
 * configuration here. mini_httpd's upstream has also been quiet since 2018.
 *
 * WHAT THE GUI DEPENDS ON, and it is very little. The pages use no rewriting,
 * no .htaccess and no PATH_INFO -- they are flat .php files in one directory.
 * The only real coupling is authentication: mini_httpd enforced HTTP Basic
 * against a generated htpasswd file and PHP read $_SERVER['REMOTE_USER'],
 * which auth.inc uses in 12 places to apply per-group page permissions. So
 * the requirements on any replacement are exactly:
 *
 *   1. Basic auth against an htpasswd file
 *   2. REMOTE_USER passed through to the CGI/FastCGI backend
 *   3. run PHP
 *
 * PHP runs as FastCGI rather than plain CGI. The old setup forked a fresh
 * php-cgi per request; a small persistent pool is faster and costs nothing.
 * ===========================================================================
 */

define('LIGHTTPD_BIN', '/usr/local/sbin/lighttpd');

/* Generate lighttpd.conf.
 *
 * Returned as text so it can be unit-tested without a filesystem.
 */
function webgui_lighttpd_config_generate() {
	global $config, $g;

	$cfg   = isset($config['system']['webgui']) && is_array($config['system']['webgui'])
	         ? $config['system']['webgui'] : array();
	$https = (isset($cfg['protocol']) && $cfg['protocol'] == "https");
	$port  = !empty($cfg['port']) ? $cfg['port'] : ($https ? 443 : 80);

	$out  = "# webGUI server configuration -- generated by m0n0wall.\n\n";

	$out .= "server.modules = (\n";
	$out .= "\t\"mod_auth\",\n";
	$out .= "\t\"mod_authn_file\",\n";
	$out .= "\t\"mod_fastcgi\",\n";
	$out .= "\t\"mod_accesslog\",\n";
	if ($https)
		$out .= "\t\"mod_openssl\",\n";
	$out .= ")\n\n";

	$out .= "server.document-root = \"{$g['www_path']}\"\n";
	$out .= "server.port          = {$port}\n";
	/* NO server.username HERE, deliberately.
	 *
	 * The webGUI must run as root: its pages exec ifconfig, pfctl, gpart and
	 * so on. mini_httpd was told "-u root" and complied. lighttpd REFUSES --
	 *   "I will not set uid to 0. Perhaps you should comment out
	 *    server.username in lighttpd.conf"
	 * -- and exits. Omitting the directive makes it keep the uid it was
	 * started with, which is root because rc.bootup runs as root. Setting it
	 * to any other user would break every page that touches the system. */
	$out .= "server.pid-file      = \"{$g['varrun_path']}/lighttpd.pid\"\n";
	$out .= "server.errorlog      = \"{$g['varlog_path']}/lighttpd.log\"\n";
	$out .= "server.indexfiles    = ( \"index.php\" )\n";
	/* KB. A firmware image is the largest thing the GUI ever receives and is
	   ~41 MB today; 4096 was sized for a config backup and rejected the
	   upload outright. Keep at or above php.ini's upload_max_filesize. */
	$out .= "server.max-request-size = 102400\n";

	/* Spool the request body to /ftmp, not the default /var/tmp. There is no
	   /var/tmp on the image, so lighttpd logged "opening temp-file failed
	   ... No such file or directory" and the upload died; and /var is not a
	   separate filesystem, it lives on the ~98 MB root RAM disk with a few
	   MB free. /ftmp is where rc.firmware mounts a RAM disk sized for the
	   image before the upload starts. */
	$out .= "server.upload-dirs = ( \"/ftmp\" )\n";
	$out .= "accesslog.filename   = \"/dev/null\"\n\n";

	$out .= "mimetype.assign = (\n";
	$out .= "\t\".html\" => \"text/html\", \".htm\" => \"text/html\",\n";
	$out .= "\t\".css\" => \"text/css\", \".js\" => \"text/javascript\",\n";
	$out .= "\t\".gif\" => \"image/gif\", \".png\" => \"image/png\",\n";
	$out .= "\t\".jpg\" => \"image/jpeg\", \".ico\" => \"image/x-icon\",\n";
	$out .= "\t\"\" => \"application/octet-stream\"\n";
	$out .= ")\n\n";

	/* --- PHP via FastCGI ---
	 * A small persistent pool. PHP_FCGI_CHILDREN is what makes php-cgi act as
	 * a FastCGI server rather than exiting after one request. */
	$out .= "fastcgi.server = ( \".php\" =>\n";
	$out .= "\t(( \"socket\"      => \"{$g['varrun_path']}/php-fastcgi.socket\",\n";
	$out .= "\t   \"bin-path\"    => \"/usr/local/bin/php-cgi\",\n";
	$out .= "\t   \"max-procs\"   => 2,\n";
	$out .= "\t   \"bin-environment\" => (\n";
	$out .= "\t       \"PHP_FCGI_CHILDREN\"     => \"4\",\n";
	$out .= "\t       \"PHP_FCGI_MAX_REQUESTS\" => \"500\"\n";
	$out .= "\t   ),\n";
	$out .= "\t   \"broken-scriptfilename\" => \"enable\"\n";
	$out .= "\t))\n";
	$out .= ")\n\n";

	/* --- authentication ---
	 * The htpasswd file is written by system_password_configure() from
	 * config.xml. auth.inc then reads REMOTE_USER to apply per-group page
	 * permissions, so passing it through is not optional. */
	if (!isset($cfg['nopassword'])) {
		$out .= "auth.backend                 = \"htpasswd\"\n";
		$out .= "auth.backend.htpasswd.userfile = \"{$g['varrun_path']}/htpasswd\"\n";
		$out .= "auth.require = ( \"/\" =>\n";
		$out .= "\t( \"method\"  => \"basic\",\n";
		$out .= "\t  \"realm\"   => \"m0n0wall\",\n";
		$out .= "\t  \"require\" => \"valid-user\" )\n";
		$out .= ")\n\n";
	}

	if ($https) {
		$out .= "ssl.engine  = \"enable\"\n";
		$out .= "ssl.pemfile = \"{$g['varetc_path']}/cert.pem\"\n";
		/* No SSLv3 or TLS 1.0/1.1. The patched mini_httpd disabled SSLv3 by
		   hand after POODLE; a modern server should not be offering any of
		   them. */
		$out .= "ssl.openssl.ssl-conf-cmd = (\n";
		$out .= "\t\"MinProtocol\" => \"TLSv1.2\",\n";
		$out .= "\t\"Options\" => \"-SessionTicket\"\n";
		$out .= ")\n\n";
	}

	return $out;
}

/* Write the configuration and start the server. Replaces the mini_httpd half
 * of system_webgui_start(); the certificate and htpasswd handling around it
 * is unchanged.
 */
function webgui_lighttpd_start() {
	global $config, $g;

	$conf = "{$g['varetc_path']}/lighttpd.conf";

	killbypid("{$g['varrun_path']}/lighttpd.pid");

	$old = umask(0077);
	file_put_contents($conf, webgui_lighttpd_config_generate());
	umask($old);

	/* Validate before starting: a firewall whose web interface fails to come
	   up is one you cannot fix remotely. */
	$out = array(); $rc = 0;
	exec(LIGHTTPD_BIN . " -tt -f " . escapeshellarg($conf) . " 2>&1", $out, $rc);
	if ($rc != 0) {
		printf("Generated lighttpd config is invalid:\n%s\n", implode("\n", $out));
		return 1;
	}

	return mwexec(LIGHTTPD_BIN . " -f " . escapeshellarg($conf));
}
